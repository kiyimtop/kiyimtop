// Настройки Cloudflare Workers.
// "name" должно совпадать с названием Worker'а в панели Cloudflare (Workers & Pages → ваш проект).
{
  "name": "kiyimtop",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Любой адрес сайта (например /c/sneakers) открывает index.html — страницы переключает сам сайт.
    "not_found_handling": "single-page-application",
    // Адреса /api/… сначала идут в сервер, а не в файлы.
    "run_worker_first": ["/api/*"]
  }
}
