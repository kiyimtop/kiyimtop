// Настройки Cloudflare Workers.
// "name" должно совпадать с названием Worker'а в панели Cloudflare (Workers & Pages → ваш проект).
{
  "name": "kiyimtop",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Номер проекта Firebase (публичный, тот же, что VITE_FIREBASE_PROJECT_ID): сервер по нему проверяет вход
  // при загрузке фото. Секретов здесь нет — они в Cloudflare → Settings → Variables and Secrets.
  "vars": { "FIREBASE_PROJECT_ID": "kiyimtop-811e7" },
  // Не стирать переменные, которые вписаны в панели Cloudflare (ADMIN_EMAILS, SITE_HOST …).
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Любой адрес сайта (например /c/sneakers) открывает index.html — страницы переключает сам сайт.
    "not_found_handling": "single-page-application",
    // Адреса /api/… сначала идут в сервер, а не в файлы.
    "run_worker_first": ["/api/*"]
  }
}
